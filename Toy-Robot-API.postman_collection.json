              "raw": "{\n  \"command\": \"LEFT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "RIGHT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/robots/{{robotId}}/commands",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "robots",
                "{{robotId}}",
                "commands"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"command\": \"RIGHT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "REPORT",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/robots/{{robotId}}/report",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "robots",
                "{{robotId}}",
                "report"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Run command sequence (JSON)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/robots/{{robotId}}/commands",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "robots",
                "{{robotId}}",
                "commands"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"commands\": \"PLACE 1,2,EAST MOVE MOVE LEFT MOVE REPORT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Run command sequence (plain text)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/plain"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/robots/{{robotId}}/commands",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "robots",
                "{{robotId}}",
                "commands"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "PLACE 0,0,NORTH\nMOVE\nRIGHT\nMOVE\nREPORT"
            }
          }
        },
        {
          "name": "Delete robot",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/robots/{{robotId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "robots",
                "{{robotId}}"
              ]
            },
            "description": ""
          }
        }
      ]
