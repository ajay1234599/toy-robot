{
  "info": {
    "name": "Toy Robot API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Truck robot on a 5x5 table. Run 'Create robot' first; it stores the id in {{robotId}} for the other requests."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "robotId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Robots",
      "item": [
        {
          "name": "Create robot",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/robots",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "robots"
              ]
            },
            "description": "Creates an unplaced robot and saves its id to {{robotId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"robotId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List robots",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/robots",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "robots"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Get robot",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/robots/{{robotId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "robots",
                "{{robotId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Place robot (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/robots/{{robotId}}/placement",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "robots",
                "{{robotId}}",
                "placement"
              ]
            },
            "description": "PLACE. Returns 422 if the position is off the table.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"x\": 1,\n  \"y\": 2,\n  \"facing\": \"EAST\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "MOVE",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/robots/{{robotId}}/commands",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "robots",
                "{{robotId}}",
                "commands"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"command\": \"MOVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "LEFT",
