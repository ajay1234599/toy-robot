    {
      "name": "Edge cases",
      "item": [
        {
          "name": "Create robot",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/robots",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "robots"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"robotId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Move that would fall is ignored",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/robots/{{robotId}}/commands",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "robots",
                "{{robotId}}",
                "commands"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"commands\": \"PLACE 0,4,NORTH MOVE RIGHT MOVE REPORT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"outputs = ['1,4,EAST']\", () => pm.expect(pm.response.json().outputs).to.eql([\"1,4,EAST\"]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Off-table PLACE is rejected (422)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/robots/{{robotId}}/placement",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "robots",
                "{{robotId}}",
                "placement"
